# Written by:  python -m server.set_password   (never commit .env)
PFD_PASSWORD_HASH=
PFD_SECRET_KEY=
PFD_PASSWORD_WEAK=1

# Where the data locations file is (same format as the July NN-vet loader).
# run_local.ps1 -Data home|office|<path> overrides this.
PFD_LOCATIONS=

# Durable store (catalogue versions, cache, reference snapshots, login log).
# Must be OUTSIDE OneDrive: OneDrive reverts files and would corrupt version history.
PFD_STORE_DIR=C:\pfd_store

# Minutes of inactivity before sign-out = PFD_IDLE_HOURS * 60
PFD_IDLE_HOURS=8

# Job slots (default: logical cores / 4)
# PFD_WORKERS=7

# Mode flags are set by the launcher; override only to test:
# PFD_SECURE_COOKIE=1
# PFD_TRUST_CF=1

# S9: folder that CONTAINS the llp package (llp\data.py, the training path's apply_scale).
# Aug 11 2026 delivery went to ...\projects\atlas\src\llp\ -- set the full path here.
# Unset: S9 runs labelled reference transforms. Set but broken: gate runs stop, by name.
PFD_LLP_SRC=

# Alerts (failed sign-ins, failed jobs). Console is always on. Each enabled
# transport is preflight-checked at startup and fails loudly if incomplete.
PFD_EMAIL_ENABLED=0
PFD_SMTP_HOST=
PFD_SMTP_PORT=587
PFD_SMTP_USER=
PFD_SMTP_PASS=
PFD_MAIL_FROM=
PFD_MAIL_TO=
PFD_SMS_GATEWAY_ENABLED=0
PFD_SMS_GATEWAY_ADDR=
PFD_TWILIO_ENABLED=0
PFD_TWILIO_SID=
PFD_TWILIO_TOKEN=
PFD_TWILIO_FROM=
PFD_TWILIO_TO=
