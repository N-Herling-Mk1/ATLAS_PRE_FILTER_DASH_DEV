# Copy to deploy/docker/stack.env (git-ignored) and fill in.
# Passed to compose with:  --env-file deploy/docker/stack.env

# Host path of the July-format locations file (it can keep its Windows paths)
PFD_LOCATIONS_HOST=C:\Users\natha\OneDrive\Desktop\0_mL_ATLAS\0_NN_vet_explore\A_\file_locations_home.txt
# Host folder that contains every CSV the locations file names; mounted read-only at /data
PFD_DATA_HOST=C:\Users\natha\OneDrive\Desktop\0_mL_ATLAS
# Rewrite the locations file's paths into the mount: FROM=>TO, ';' between pairs
PFD_PATH_MAP=C:\Users\natha\OneDrive\Desktop\0_mL_ATLAS=>/data

# Cloudflare Zero Trust -> Networks -> Tunnels -> (tunnel) -> install connector: the token
TUNNEL_TOKEN=

# image tag and the commit it was built from (run_docker.ps1 fills PFD_CODE_COMMIT)
PFD_TAG=dev
